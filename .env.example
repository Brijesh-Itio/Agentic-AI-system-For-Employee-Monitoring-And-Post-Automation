# Copy this file to .env and fill in real values. Never commit .env.
#
# Gmail App Password setup (module 8):
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already on
#   3. Go to "App passwords", create one for "Mail" / "Other (WorkPulse AI)"
#   4. Google gives you a 16-character password — use THAT below, not your
#      normal Gmail password (Gmail blocks plain-password SMTP login).

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_RECIPIENT_EMAIL=

# LinkedIn login (module 18): only used for the first run, which saves a
# session cookie file (linkedin_cookies.json) — after that the agent
# reuses the saved session and these aren't read again. Posting is real
# browser automation on your actual account; only fill these in if you
# want the agent able to post there on its own.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Pexels image search (module 18.3): free API key, no cost. Get one at
# https://www.pexels.com/api/ — sign up, then copy the key shown on your
# dashboard. Without this, LinkedIn posts still work, just without an image.
PEXELS_API_KEY=

# Puter.js image generation (module 27, current default image provider).
# Server-side use needs an auth token, not an API key: sign in at
# https://puter.com/dashboard#account -> "API token" -> "Create token".
# Treat it like a password. Blank = image generation fails closed until
# IMAGE_PROVIDER_DEFAULT (api/config.py) is switched back to "fastsd".
PUTER_AUTH_TOKEN=

SECRET_KEY=change-this-in-production

# Google SSO ("Sign in with Google"): leave both blank to keep it off.
#   1. https://console.cloud.google.com/apis/credentials -> Create
#      Credentials -> OAuth client ID -> Web application
#   2. Authorized redirect URI: {API_PUBLIC_URL}/api/auth/sso/google/callback
#      (must match API_PUBLIC_URL below exactly, e.g.
#      http://localhost:8000/api/auth/sso/google/callback for local dev)
#   3. Copy the Client ID and Client Secret it gives you below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This backend's own publicly reachable base URL and the frontend's URL —
# used to build the Google redirect_uri and to send the browser back to
# the right place once SSO completes. Update both for a real deployment.
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# CORS (module 24.2/24.3): when the dashboard is deployed to Vercel instead
# of localhost:5173, add its real URL here too — pydantic-settings parses a
# JSON array from this env var, e.g.:
# CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# SEO Agentic AI (module 25): which LLM backend SEO tasks run on. Leave as
# "ollama" (or blank) to keep every SEO task on the zero-cost local stack —
# nothing below this line is required for that. To point a specific task at
# a paid provider instead, set SEO_LLM_PROVIDER_<TASK>=claude|openai (e.g.
# SEO_LLM_PROVIDER_CONTENT=claude) and fill in that provider's key below;
# `pip install anthropic` / `pip install openai` first — both are optional,
# lazy-imported only when actually selected.
SEO_LLM_PROVIDER_DEFAULT=ollama

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_EMBED_MODEL=text-embedding-3-small

# SEO Agentic AI: CMS integration (module 26). Fill in whichever CMS your
# seo_sites row(s) actually use — leave both blank and CMS calls return
# empty/failed results gracefully rather than erroring.
#
# WordPress: create an Application Password at
#   {your-site}/wp-admin/profile.php -> "Application Passwords" -> name it
#   "WorkPulse AI" -> use the generated password below (not your login password).
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
#
# Webflow: https://webflow.com/dashboard -> your site -> Apps & Integrations
#   -> API access -> generate a token with CMS read/write scope.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=
# Field-name mapping for your collection's schema — defaults match
# Webflow's own default Blog template; change if yours differs.
WEBFLOW_FIELD_TITLE=name
WEBFLOW_FIELD_EXCERPT=post-summary
WEBFLOW_FIELD_CONTENT=post-body

# PageSpeed Insights (module 26): works fine left blank (free anonymous
# quota); get a key at https://developers.google.com/speed/docs/insights/v5/get-started
# only if you're checking enough pages/day to hit the anonymous rate limit.
PAGESPEED_API_KEY=

# GSC + GA4 (module 26.5/26.6): both authenticate as one Google Cloud
# service account.
#   1. console.cloud.google.com -> IAM & Admin -> Service Accounts ->
#      Create -> download its JSON key -> path it below.
#   2. Search Console: property Settings -> Users and permissions -> add
#      that service account's email as a user.
#   3. GA4: Admin -> Property Access Management -> add that same email.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# Exactly as shown in GSC's property switcher, e.g. https://workpulse.ai/
# or sc-domain:workpulse.ai
GSC_SITE_URL=
# GA4 Admin -> Property Settings -> Property ID, formatted "properties/<id>"
GA4_PROPERTY_ID=

# SEO Agentic AI: image generation (module 27). "fastsd" (the default)
# uses your existing local FastSD CPU server (module 18.3) — nothing
# below this line is required for that. To point a task at a paid
# provider instead, set IMAGE_PROVIDER_<TASK>=stability (e.g.
# IMAGE_PROVIDER_BLOG_HERO=stability) and fill in the key below.
IMAGE_PROVIDER_DEFAULT=fastsd
STABILITY_API_KEY=

# SEO Agentic AI: Slack digest delivery (module 29). Leave blank to keep
# digests generating/stored without also posting to Slack. Get a webhook
# at api.slack.com/apps -> your app -> Incoming Webhooks -> add one.
SLACK_WEBHOOK_URL=

# SEO Agentic AI: autonomous daily scheduling (module 33). Runs the full
# pipeline (audit, GSC/GA4, PageSpeed, digest+Slack) once a day per
# active site with zero manual clicks. Set to false to go back to
# manual-only triggers; the manual buttons/endpoints keep working
# either way. SEO_AUTOMATION_HOUR is the 24h local hour it fires.
SEO_AUTOMATION_ENABLED=true
SEO_AUTOMATION_HOUR=6

# SEO Agentic AI: social media automation (module 30). Content
# generation needs no config (uses the LLM factory above). Automated
# posting only exists for LinkedIn — reuses LINKEDIN_EMAIL/PASSWORD
# already set earlier in this file (module 18); Twitter/Instagram/
# Facebook stay in a human-review queue, no config needed for that.

# SEO Agentic AI: backlink/brand-mention monitoring (module 31). Free,
# no key: create a Google Alert (google.com/alerts) for your brand name,
# edit it, set "Deliver to" -> RSS feed, paste that feed URL below.
BACKLINK_PROVIDER_DEFAULT=google_alerts
GOOGLE_ALERTS_RSS_URL=
# Accepted but not yet wired to a working provider — see
# automation/seo/backlinks/factory.py for why.
AHREFS_API_KEY=

# Semrush domain-level metrics (Authority Score, organic/paid keywords,
# organic traffic, referring domains, backlinks count) — Backlinks tab's
# "Domain Overview" panel. Get a key at Semrush -> profile icon -> API.
# NOT free: Semrush's API spends purchased "API units" tied to a paid
# subscription plan, unlike PAGESPEED_API_KEY above. Blank = panel stays
# off. See automation/seo/semrush_client.py.
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=us

# Instagram Graph API (Content Publishing) — the "Publish" button in the
# Social tab. Needs: an Instagram Business/Creator account, a Meta
# developer app (developers.facebook.com), and a long-lived access token
# with instagram_business_basic + instagram_business_content_publish
# scopes, generated via Instagram Login. Blank = the app is upfront that
# no automated posting exists for this platform, rather than pretending.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

